# Secrets come from the environment so nothing sensitive is committed. See docs/RELEASE.md.
app_identifier("com.mckelveygreg.sansapp")
apple_id(ENV["FASTLANE_APPLE_ID"]) # your Apple Developer account email
team_id(ENV["FASTLANE_TEAM_ID"]) # Apple Developer (portal) team id
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) # App Store Connect team id (optional; only if you're on >1 team)

# Android (Google Play). package_name matches app.config.ts; the Play service-account JSON authorizes
# uploads (set ANDROID_PLAY_JSON_KEY to its path — see docs/RELEASE.md).
for_platform(:android) do
  package_name("com.mckelveygreg.sansapp")
  json_key_file(ENV["ANDROID_PLAY_JSON_KEY"])
end
