# SansApp iOS release lanes — roll-your-own, no EAS / paid service. See docs/RELEASE.md.
#
# One-time (interactive, needs your Apple 2FA):  fastlane ios certs
# TestFlight:                                     fastlane ios beta
# App Store (uploads binary + metadata):          fastlane ios release
# Secrets live in .env.local (not .env): Expo CLI refuses to load personal secrets — e.g. the
# Apple app-specific password — from a non-.local env file, and `prep` shells out to expo prebuild.
# fastlane only auto-loads .env, so pull in .env.local explicitly.
Dotenv.overload(File.expand_path("../.env.local", __dir__)) if File.exist?(File.expand_path("../.env.local", __dir__))

# App Review contact details (name/email/phone) are PII, so they come from .env.local (gitignored) —
# never committed to this public repo. The non-PII review notes stay in metadata/review_information/
# notes.txt. Passed to deliver, whose Fastfile values take precedence over any files.
def app_review_info
  env = {
    first_name: "APP_REVIEW_FIRST_NAME",
    last_name: "APP_REVIEW_LAST_NAME",
    email_address: "APP_REVIEW_EMAIL",
    phone_number: "APP_REVIEW_PHONE",
  }
  missing = env.values.select { |k| ENV[k].to_s.strip.empty? }
  UI.user_error!("Set these App Review vars in .env.local: #{missing.join(', ')}") unless missing.empty?
  info = env.transform_values { |k| ENV[k].strip }
  notes = File.expand_path("metadata/review_information/notes.txt", __dir__)
  info[:notes] = File.read(notes).strip if File.exist?(notes)
  info
end

default_platform(:ios)

XCODEPROJ = "ios/SansApp.xcodeproj"

platform :ios do
  desc "Regenerate the native iOS project (Expo prebuild) + install pods"
  lane :prep do
    # CNG: ios/ is git-ignored and regenerated from app.config.ts.
    sh("cd .. && npx expo prebuild --platform ios --no-install")
    cocoapods(podfile: "ios/Podfile")
  end

  desc "Register the App ID (Developer Portal) + app record (App Store Connect). Run ONCE before certs."
  lane :register do
    produce(
      app_identifier: "com.mckelveygreg.sansapp",
      app_name: "SansApp — PBDR Elite Editor",
      language: "English",
      sku: "com.mckelveygreg.sansapp",
    )
  end

  desc "Create/renew signing certs + profiles in the private match repo (run once; needs 2FA)"
  lane :certs do
    match(type: "appstore", readonly: false)
  end

  desc "Fetch signing certs + profiles (read-only) — used by build/beta/release"
  lane :sync_signing do
    match(type: "appstore", readonly: true)
    # prebuild regenerates ios/ with no team/profile, so signing must be re-applied every build.
    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["FASTLANE_TEAM_ID"],
      bundle_identifier: "com.mckelveygreg.sansapp",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["com.mckelveygreg.sansapp"],
      targets: ["SansApp"],
    )
  end

  desc "Capture App Store screenshots on the simulator (in-app demo mode — no hardware)"
  lane :screenshots do
    sh("cd .. && npm run screenshots -- --build")
  end

  desc "Build a signed App Store .ipa into ./build"
  lane :build do
    prep
    sync_signing
    build_app # reads Gymfile
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    prep
    sync_signing
    # Build number = next TestFlight build (prep already reset it from app.config.ts).
    next_build = (latest_testflight_build_number(initial_build_number: 0) rescue 0) + 1
    increment_build_number(xcodeproj: XCODEPROJ, build_number: next_build)
    build_app
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build and upload binary + metadata to App Store Connect (manual submit/release)"
  lane :release do
    prep
    sync_signing
    build_app
    deliver(app_review_information: app_review_info) # + Deliverfile/metadata/screenshots
  end

  # Metadata/screenshot updates for an ALREADY-uploaded build — no rebuild, no binary re-upload.
  # Split in two so a flaky screenshot upload can't block a text-only change (and vice versa).

  desc "Push text metadata only (keywords, description, notes) — no rebuild, no binary, no screenshots"
  lane :metadata do
    deliver(app_review_information: app_review_info, skip_binary_upload: true, skip_screenshots: true)
  end

  desc "Upload screenshots only — no rebuild, no binary, no text metadata"
  lane :screenshots_upload do
    deliver(skip_binary_upload: true, skip_metadata: true)
  end
end

# --- Android (Google Play) -----------------------------------------------------------------------
# One-time: create an upload keystore (`keytool -genkeypair ...`) and a Play Console service-account
# JSON, then set the env vars listed in docs/RELEASE.md. android/ is regenerated by Expo prebuild
# (CNG), so we sign via Gradle's `android.injected.signing.*` properties rather than editing
# build.gradle — nothing sensitive is committed.
#
#   Internal testing track:   fastlane android beta
#   Production (draft):       fastlane android release
platform :android do
  desc "Regenerate the native Android project (Expo prebuild)"
  lane :prep do
    sh("cd .. && npx expo prebuild --platform android --no-install")
  end

  desc "Build a signed release AAB (needs ANDROID_KEYSTORE_* env vars)"
  lane :build do
    prep
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      }.compact,
    )
  end

  desc "Build + upload the AAB to the Play Store internal testing track"
  lane :beta do
    build
    upload_to_play_store(
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build + upload the AAB to the Play Store production track (staged as a draft)"
  lane :release do
    build
    upload_to_play_store(
      track: "production",
      release_status: "draft",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
    )
  end
end
