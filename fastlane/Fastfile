# SansApp iOS release lanes — roll-your-own, no EAS / paid service. See docs/RELEASE.md.
#
# One-time (interactive, needs your Apple 2FA):  fastlane ios certs
# TestFlight:                                     fastlane ios beta
# App Store (uploads binary + metadata):          fastlane ios release
default_platform(:ios)

XCODEPROJ = "ios/SansApp.xcodeproj"

platform :ios do
  desc "Regenerate the native iOS project (Expo prebuild) + install pods"
  lane :prep do
    # CNG: ios/ is git-ignored and regenerated from app.config.ts.
    sh("cd .. && npx expo prebuild --platform ios --no-install")
    cocoapods(podfile: "ios/Podfile")
  end

  desc "Create/renew signing certs + profiles in the private match repo (run once; needs 2FA)"
  lane :certs do
    match(type: "appstore", readonly: false)
  end

  desc "Fetch signing certs + profiles (read-only) — used by build/beta/release"
  lane :sync_signing do
    match(type: "appstore", readonly: true)
  end

  desc "Build a signed App Store .ipa into ./build"
  lane :build do
    prep
    sync_signing
    build_app # reads Gymfile
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    prep
    sync_signing
    # Build number = next TestFlight build (prep already reset it from app.config.ts).
    next_build = (latest_testflight_build_number(initial_build_number: 0) rescue 0) + 1
    increment_build_number(xcodeproj: XCODEPROJ, build_number: next_build)
    build_app
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build and upload binary + metadata to App Store Connect (manual submit/release)"
  lane :release do
    prep
    sync_signing
    build_app
    deliver # reads Deliverfile + fastlane/metadata + fastlane/screenshots
  end
end

# --- Android (Google Play) -----------------------------------------------------------------------
# One-time: create an upload keystore (`keytool -genkeypair ...`) and a Play Console service-account
# JSON, then set the env vars listed in docs/RELEASE.md. android/ is regenerated by Expo prebuild
# (CNG), so we sign via Gradle's `android.injected.signing.*` properties rather than editing
# build.gradle — nothing sensitive is committed.
#
#   Internal testing track:   fastlane android beta
#   Production (draft):       fastlane android release
platform :android do
  desc "Regenerate the native Android project (Expo prebuild)"
  lane :prep do
    sh("cd .. && npx expo prebuild --platform android --no-install")
  end

  desc "Build a signed release AAB (needs ANDROID_KEYSTORE_* env vars)"
  lane :build do
    prep
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      }.compact,
    )
  end

  desc "Build + upload the AAB to the Play Store internal testing track"
  lane :beta do
    build
    upload_to_play_store(
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build + upload the AAB to the Play Store production track (staged as a draft)"
  lane :release do
    build
    upload_to_play_store(
      track: "production",
      release_status: "draft",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
    )
  end
end
