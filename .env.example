# Copy this to `.env` (git-ignored) and fill it in. fastlane AUTO-LOADS `.env` from the repo root
# when you run a lane — no `source` needed. Only required for releasing (docs/RELEASE.md).

# --- iOS / App Store (fastlane match + App Store Connect) ---
export FASTLANE_APPLE_ID="you@example.com"                 # email on your Apple Developer account
export FASTLANE_TEAM_ID="XXXXXXXXXX"                        # Apple Developer team id (portal → Membership)
export MATCH_GIT_URL="git@github.com:you/your-certs.git"    # private repo match stores signing in
export MATCH_PASSWORD=""                                    # passphrase that encrypts the certs repo

# --- Android / Google Play (only for `fastlane android ...`) ---
export ANDROID_KEYSTORE_PATH=""
export ANDROID_KEYSTORE_PASSWORD=""
export ANDROID_KEY_ALIAS=""
export ANDROID_KEY_PASSWORD=""
export ANDROID_PLAY_JSON_KEY=""                            # path to the Play service-account JSON
