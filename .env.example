# Copy this to `.env.local` (git-ignored) and fill it in. The Fastfile loads it when you run a
# lane — no `source` needed. Only required for releasing (docs/RELEASE.md). It must be `.env.local`,
# not `.env`: Expo CLI refuses to load personal secrets (like the Apple app-specific password) from
# a non-.local env file, and the fastlane lanes shell out to `expo prebuild`.

# --- iOS / App Store (fastlane match + App Store Connect) ---
export FASTLANE_APPLE_ID="you@example.com"                 # email on your Apple Developer account
export FASTLANE_TEAM_ID="XXXXXXXXXX"                        # Apple Developer team id (portal → Membership)
export MATCH_GIT_URL="git@github.com:you/your-certs.git"    # private repo match stores signing in
export MATCH_PASSWORD=""                                    # passphrase that encrypts the certs repo
export FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=""      # account.apple.com → App-Specific Passwords (binary upload)

# --- Optional build-time feature flags (inlined by Metro; unset = off in every public build) ---
# export EXPO_PUBLIC_ENABLE_RECIPES=1   # include the in-progress Recipes page in your local builds

# --- Android / Google Play (only for `fastlane android ...`) ---
export ANDROID_KEYSTORE_PATH=""
export ANDROID_KEYSTORE_PASSWORD=""
export ANDROID_KEY_ALIAS=""
export ANDROID_KEY_PASSWORD=""
export ANDROID_PLAY_JSON_KEY=""                            # path to the Play service-account JSON
