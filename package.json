{
  "name": "sansapp",
  "version": "1.1.1",
  "private": true,
  "description": "Unofficial open-source mobile editor for the Tech 21 SansAmp Programmable Bass Driver DI Elite bass pedal",
  "license": "GPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.core.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fallow": "fallow dead-code --baseline .fallow-baseline.json && fallow dupes",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:app && npm test && npm run fallow",
    "web": "expo start --web",
    "start": "expo start --dev-client",
    "ios": "EXPO_RN_FROM_SOURCE=1 expo run:ios",
    "ios:device": "EXPO_RN_FROM_SOURCE=1 expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ports": "tsx tools/list-ports.ts",
    "ble-check": "tsx tools/ble-check.ts",
    "capture": "tsx tools/capture.ts",
    "emulate": "tsx tools/emulate.ts",
    "screenshots": "tsx tools/screenshots.ts",
    "replay": "tsx tools/replay.ts",
    "send": "tsx tools/send.ts",
    "probe": "tsx tools/probe-hardware.ts",
    "verify": "tsx tools/verify-mapping.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@motiz88/react-native-midi": "^0.0.6",
    "@react-navigation/bottom-tabs": "^7.18.6",
    "expo": "^57.0.2",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.5",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-router": "~57.0.3",
    "expo-sharing": "~57.0.2",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@julusian/midi": "^3.6.1",
    "@types/node": "^26.1.0",
    "fallow": "^2.104.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
